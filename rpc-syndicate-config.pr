<require-service <daemon <worker 1>>>
<require-service <daemon <worker 2>>>
<require-service <daemon <jobqmanager>>>

<daemon <jobqmanager>{
  argv: "exec python3 -m src.workers.jobq-manager"
  protocol: application/syndicate
}>

? <run-service <daemon <worker ?n>>> [
  <daemon <worker $n> {
    argv: "exec python3 -m src.workers.worker"
    protocol: application/syndicate
  }>
  ? <service-object <daemon <worker $n>> ?w> [
    $w += { "worker-dataspace": $config, "worker": $w }
    $log ! <log "-" { worker-ready: $w worker-number: $n }>
    <worker-ready $w>
  ]
]

? <service-object <daemon <jobqmanager>> ?c> [
  $c += { "worker-dataspace": $config}
  <jobqmanager $c>
]