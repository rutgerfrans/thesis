<require-service <daemon <worker 0>>>
<require-service <daemon <worker 1>>>
<require-service <daemon <worker 2>>>

? <run-service <daemon <worker ?n>>> [
  <daemon <worker $n> {
    argv: "exec python3 -m src.workers.samworker"
    protocol: application/syndicate
  }>
  ? <service-object <daemon <worker $n>> ?w> [
    $w += { "worker-dataspace": $config, "worker": $n }
    $log ! <log "-" { worker-ready: $w worker-number: $n }>
    <worker-ready $config $n>
  ]
]

<require-service <daemon coordinator>>

<daemon coordinator {
  argv: "exec python3 -m src.workers.samcoordinator"
  protocol: application/syndicate
}>

? <service-object <daemon coordinator> ?c> [
  $c += { "worker-dataspace": $config, coordinator: $c }
  <coordinator $c>
]