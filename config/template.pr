# WORKERS_PLACEHOLDER
<require-service <daemon <epoch-manager>>>
<require-service <daemon <jobq>>>

<daemon <epoch-manager> {
  argv: "exec python3 -m src.sam.epoch-manager"
  protocol: application/syndicate
}>

<daemon <jobq> {
  argv: "exec python3 -m src.sam.jobq"
  protocol: application/syndicate
}>

? <run-service <daemon <worker ?n>>> [
  <daemon <worker $n> {
    argv: "exec python3 -m src.sam.worker"
    protocol: application/syndicate
  }>
  ? <service-object <daemon <worker $n>> ?w> [
    $w += { "worker-dataspace": $config }
  ]
]

? <service-object <daemon <jobq>> ?q> [
  $q += { "dataspace": $config }
]

? <service-object <daemon <epoch-manager>> ?c> [
  $c += { "worker-dataspace": $config, "syndicate-server-control": $control }
]